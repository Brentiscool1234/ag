# Copy to .env and fill in. Never commit .env.

# API keys are normally entered per-account in the dashboard (Account settings).
# These env vars are OPTIONAL fallbacks used when an account has no key of its
# own — handy for local/CLI use or a single shared key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Path to the SQLite database file (mount this on a persistent volume in prod).
DATABASE_PATH=./data/app.db

# Optional shared password gate for the dashboard (leave blank to disable).
# This is a stopgap for internal use — replace with real auth before selling access.
DASHBOARD_PASSWORD=
