# Copy to .env and fill in. Never commit .env.

# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Model used for page content. claude-opus-5 gives the best anti-doorway quality.
# Cheaper option for high volume: claude-sonnet-5
SEO_MODEL=claude-opus-5

# Path to the SQLite database file (mount this on a persistent volume in prod).
DATABASE_PATH=./data/app.db

# Optional shared password gate for the dashboard (leave blank to disable).
# This is a stopgap for internal use — replace with real auth before selling access.
DASHBOARD_PASSWORD=
